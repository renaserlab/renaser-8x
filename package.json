{
  "name": "8x",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "worker": "node --env-file=.env.local --import=tsx worker/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:supabase": "node --env-file=.env.local --import=tsx node_modules/vitest/vitest.mjs run tests/supabase",
    "benchmark": "node --env-file=.env.local --import=tsx scripts/benchmark-ia.ts",
    "qa": "node --env-file=.env.local --import=tsx scripts/qa.mts",
    "prueba:medicion": "node --env-file=.env.local --import=tsx scripts/prueba-medicion.mts",
    "prueba:indicadores": "node --env-file=.env.local --import=tsx scripts/prueba-indicadores.mts",
    "prueba:borrado": "node --env-file=.env.local --import=tsx scripts/prueba-borrado.mts",
    "verificar": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@dagrejs/dagre": "^3.1.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@xyflow/react": "^12.11.3",
    "motion": "^13.1.1",
    "next": "16.3.2",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/dagre": "^0.7.54",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
