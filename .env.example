# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local al repositorio.

# Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor y worker. Salta RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Proveedor de IA
# Proveedor: anthropic (por defecto) o gemini
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# claude-sonnet-5 con anthropic; gemini-3.7-flash (u otro) con gemini
AI_MODEL=claude-sonnet-5

# Opcional: transcripción y voz de notas de audio subidas (Whisper / TTS).
# Sin esta llave, el micrófono del navegador sigue funcionando para responder hablando.
OPENAI_API_KEY=

# Worker
WORKER_CONCURRENCIA=6
WORKER_LEASE_MINUTOS=10

# URL pública (para enlaces de participantes)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cola (fase 13): fairness por empresa y tope global de llamadas simultáneas (suma de todos los workers)
WORKER_MAX_PESADOS_POR_EMPRESA=2
WORKER_MAX_GLOBAL=12
AI_TIMEOUT_MS=120000

# Marca que aparece en los entregables (la del consultor, no 8X)
MARCA_CONSULTORIA=

# Tests de integración contra Supabase (fase 5): si existen, `npm run test:supabase` los ejecuta contra esa base (usa una de prueba)
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=
GEMINI_THINKING_LEVEL=low
GEMINI_THINKING_HEADROOM=6000
GEMINI_TEMPERATURE=0
GEMINI_REINTENTOS_503=12
