# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local
benchmark/ultimo-error.txt

.vercel
.env*
# la plantilla sin valores sí entra al repo; .env.test con valores reales no
!.env.test.example
!.env.example
!.env.worker-produccion
scripts/tmp-w.mjs

# material confidencial de clientes: no entra al historial del repositorio del producto
/clientes

# diseño: lo generado (HTML pintado, CSS compilado y capturas) se rehace con el arnés; no va al historial
/diseno/render/salida/
/diseno/**/capturas/
/.impeccable/review/

# scripts locales de una sola vez: leen o escriben datos de clientes y no se publican (lo que ya estaba
# publicado se saca del índice con git rm --cached, a mano, en el commit limpio)
scripts/tmp/
scripts/incorporar-manuales-*.mts
