# Plantilla del entorno de PRUEBA. Copia este archivo a .env.test y completa los valores del proyecto de prueba.
# .env.test no se sube al repositorio. Aquí nunca va el proyecto de producción (ref otqfqafstrohugvgbkmd).

# Qué es este proceso para el candado (src/lib/entorno.ts): prueba o local.
# Sin esta variable, vitest, los scripts y el worker rehúsan escribir: el destino es ambiguo.
ENTORNO=prueba

# Lista, separada por comas, de refs de proyectos Supabase a los que SÍ se puede escribir desde pruebas y scripts.
# El ref es la parte <ref> de https://<ref>.supabase.co; para un Supabase local pon «local». Producción se rechaza aunque aparezca.
DESTINOS_PRUEBA=<ref-del-proyecto-de-prueba>

# URL del proyecto de PRUEBA (Supabase → Settings → API). Es la que leen la app, los scripts y el worker.
# BD, Storage y Auth viven detrás de esta misma URL: el candado comprueba el ref una vez y cubre las tres.
NEXT_PUBLIC_SUPABASE_URL=https://<ref-del-proyecto-de-prueba>.supabase.co

# Clave anónima (anon, public) del proyecto de PRUEBA.
# La usan los clientes con sesión de usuario; respeta RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key-del-proyecto-de-prueba>

# Clave service_role del proyecto de PRUEBA. Salta RLS: solo servidor, scripts y worker.
# Aunque sea de prueba, trátala como secreto: no la pegues en chats ni en documentos.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-del-proyecto-de-prueba>

# 1 = las pruebas de integración (tests/supabase) se PIDEN: si el destino no está autorizado, FALLAN con el motivo.
# 0 = no se piden: se saltan con nombre «SALTADA (sin entorno de prueba): …». Pon 1 cuando el proyecto de prueba exista.
PRUEBAS_INTEGRACION=0
